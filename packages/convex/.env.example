# This file is only documentation. Convex secrets are NOT stored in files.
# Set them on your Convex deployment instead:
#
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set BETTER_AUTH_SECRET "<random 32+ bytes, e.g. from: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\">"
#   npx convex env set DISCORD_CLIENT_ID <client id>
#   npx convex env set DISCORD_CLIENT_SECRET <client secret>
#
# `npx convex dev` writes CONVEX_DEPLOYMENT / CONVEX_URL / CONVEX_SITE_URL to .env.local automatically.
